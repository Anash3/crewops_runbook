# .env.example for CrewOps Agent
# Copy to .env and fill in actual values before running.

# PostgreSQL connection URL (SQLAlchemy style)
# e.g. postgresql://user:password@localhost:5432/crewops
DATABASE_URL=postgresql://user:password@localhost:5432/crewops

# MCP server configuration
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Optional API key for MCP protection (leave empty for dev)
MCP_API_KEY=

# Optional bearer key for localhost human approval requests
RUNBOOK_APPROVAL_API_KEY=

# Local TrueForge agent runtime (used by truefoundry_agent.py)
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_MODEL=openai/gpt-5-6-luna

# Streamable HTTP MCP endpoint reachable by the local TrueForge runtime
CREWOPS_MCP_URL=http://127.0.0.1:8000/mcp
